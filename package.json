{
  "name": "orbital-canvas",
  "version": "2.0.0",
  "description": "Generative particle animation on a 3D orbital scene, rendered to canvas with switchable 3D and top-down 2D projections.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Intrinsical-AI/OrbitalCanvas.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node --test --test-timeout=120000 scripts/smoke-browser.mjs",
    "smoke:firefox": "ORBITAL_BROWSER=firefox npm run smoke",
    "smoke:webkit": "ORBITAL_BROWSER=webkit npm run smoke",
    "visuals": "node scripts/generate-visuals.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "node scripts/check-mediabunny-version.js && patch-package --error-on-fail"
  },
  "dependencies": {
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "mediabunny": "1.51.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.0",
    "eslint": "^10.8.0",
    "globals": "^16.5.0",
    "patch-package": "8.0.1",
    "prettier": "^3.6.2",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
